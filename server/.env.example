# Copy to /etc/kai-contact.env on the Pi, fill in, then:
#   sudo chmod 600 /etc/kai-contact.env
#   sudo chown root:root /etc/kai-contact.env
# Never commit the filled-in version.

# Origins allowed to POST the form. Comma-separated, scheme included, no
# trailing slash. Add the GitHub Pages URL too if you deploy there.
ALLOWED_ORIGINS=https://kaispicer.com,https://www.kaispicer.com

# Where accepted messages are appended as JSON lines.
MESSAGE_LOG=/var/lib/kai-contact/messages.jsonl

# SMTP. For Gmail this must be an App Password, not your account password:
# myaccount.google.com/apppasswords (requires 2FA on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=spicerkai@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_TO=spicerkai@gmail.com

# Max submissions per IP per window (seconds).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600
