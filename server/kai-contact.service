[Unit]
Description=Contact form endpoint for kai-spicer.com
After=network-online.target
Wants=network-online.target

[Service]
User=spicerke
Group=spicerke
WorkingDirectory=/opt/kai-contact
EnvironmentFile=/etc/kai-contact.env

# One worker, because the rate limiter keeps its state in process memory.
# Threads handle the concurrency a contact form actually sees.
ExecStart=/opt/kai-contact/.venv/bin/gunicorn \
    --workers 1 --threads 4 \
    --bind 127.0.0.1:8080 \
    --access-logfile - --error-logfile - \
    app:app

Restart=always
RestartSec=5

# Hardening — the app needs to read its code and append one log file, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kai-contact
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
